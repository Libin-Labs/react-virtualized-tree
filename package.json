{
  "name": "@lp-labs/react-virtualized-tree",
  "version": "0.1.0",
  "description": "Accessible virtualized React trees with filtering, selection and no runtime dependencies beyond React.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "tsc --noEmit",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run check && npm test && npm run build && npm run test:package"
  },
  "peerDependencies": { "react": ">=18.0.0" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=18" },
  "keywords": ["react", "tree", "virtualized", "virtual-scroll", "accessible", "filter"]
}